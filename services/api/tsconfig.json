{
  "extends": "../../tsconfig.profiles/service.json",
  "compilerOptions": {
    "composite": false,
    // This package consumes inferred declarations across the chat/RPC
    // boundary; stale tsbuildinfo can hide dependency type changes.
    "incremental": false,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": ["ESNext", "DOM"],
    "tsBuildInfoFile": "./.cache/tsconfig.tsbuildinfo",
    // pnpm-workspace.yaml sets injectWorkspacePackages: true, which
    // hard-copies (not symlinks) these packages into a peer-isolated
    // .pnpm virtual-store variant wherever a react-peer-dependent package
    // (career-services, ai, ...) requires one. That copy is frozen at
    // `pnpm install` time, before `pnpm build` has produced build/*.d.ts,
    // so its own package.json "types" condition 404s and TS falls through
    // to the "default" condition -- real src/*.ts. That forces a full
    // structural check of Drizzle/Kysely repository source (expensive)
    // instead of a cheap prebuilt .d.ts, for every package these
    // internally import from each other. These `paths` entries pin
    // resolution to the real build output regardless of which node_modules
    // copy a given import started from. Verified: same 0-error result,
    // ~13% faster `tsc -p tsconfig.emit.json` (measured via
    // scripts/bench-tsserver.mjs-style A/B, not tsserver-specific).
    "paths": {
      "@/*": ["./*"],
      "@hominem/db": ["../../packages/db/build/index.d.ts"],
      "@hominem/ai": ["../../packages/ai/build/index.d.ts"],
      "@hominem/career-services": ["../../packages/career/build/index.d.ts"],
      "@hominem/queues": ["../../packages/queues/build/index.d.ts"],
      "@hominem/services": ["../../packages/services/build/index.d.ts"],
      "@hominem/telemetry": ["../../packages/telemetry/build/index.d.ts"],
      "@hominem/utils": ["../../packages/utils/build/index.d.ts"],
      "@hominem/env": ["../../packages/env/build/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "build", ".turbo", ".cache", "coverage", "*.tsbuildinfo"],
  // Deliberately NOT itself composite: rpc/app.ts's `typeof rpcApp`
  // inference re-exports types from these packages (AIUsageFeature,
  // AffordabilityVerdict, ...), and if THIS package became a composite
  // project, TS's "portable type" check (TS2883) would refuse to infer
  // AppType without an explicit annotation — defeating Hono's RPC
  // type-inference pattern. `composite: false` above stays.
  //
  // A plain `references` entry (below) is a different, safe thing: it only
  // lets THIS package's own typecheck read packages/chat's live source
  // instead of its build/*.d.ts, the same as every other consumer with a
  // references entry. Verified empirically (full `tsc --noEmit` and a full
  // `tsc -p tsconfig.emit.json` declaration-only build both pass clean with
  // this in place) — TS2883 is about composite-ness, not about having
  // references at all.
  "references": [{ "path": "../../packages/chat" }]
}
