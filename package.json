{
  "name": "hominem",
  "private": true,
  "description": "hominem",
  "keywords": [],
  "homepage": "https://github.com/hackefeller/hominem#readme",
  "bugs": {
    "url": "https://github.com/hackefeller/hominem/issues"
  },
  "license": "ISC",
  "author": {
    "name": "chase bridges",
    "email": "code@hominem.io",
    "url": "https://ponti.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackefeller/hominem.git"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "dev": "turbo run dev --ui stream --filter='!@hominem/omiro'",
    "dev:api": "turbo run dev --filter @hominem/api",
    "dev:career": "turbo run dev --filter @hominem/career",
    "dev:finance": "turbo run dev --filter @hominem/finance",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/app-test AUTH_E2E_SECRET=otp-secret turbo run test",
    "typecheck": "turbo run typecheck",
    "ui:check-canonical": "test ! -e packages/ui && ! rg -n '@hominem/ui' --glob '!node_modules/**' --glob '!package.json' ."
  },
  "devDependencies": {
    "@expo/image-utils": "^0.11.4",
    "@expo/prebuild-config": "~56.0.16",
    "@railway/cli": "5.25.1",
    "@types/node": "^25.4.0",
    "@types/pg": "^8.18.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@xmldom/xmldom": "0.8.13",
    "knip": "^6.4.1",
    "oxfmt": "0.56.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.10.0",
    "turbo": "^2.10.0",
    "typescript": "6.0.3",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
