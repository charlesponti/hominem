# Copy this file to .env.development.local. EXPO_PUBLIC_* values are embedded
# into the client bundle; API URLs are public configuration, not credentials.
# For a physical device, replace localhost with a reachable LAN or tunnel URL.
#
# Do NOT set APP_ENV here. Every package.json script already prefixes the
# app environment explicitly (e.g. `APP_ENV=production expo prebuild`), and
# app.config.ts refuses to guess it. An ambient APP_ENV in a .local file has
# previously caused a "production" build to silently ship the dev app
# identity to the App Store — see app.config.ts's getAppEnvironment().

EXPO_PUBLIC_API_BASE_URL="http://localhost:4040"
EXPO_PUBLIC_POSTHOG_API_KEY="<posthog-public-key>"
EXPO_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
EXPO_PUBLIC_SENTRY_DSN="<sentry-public-dsn>"
