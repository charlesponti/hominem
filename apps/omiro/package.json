{
  "name": "@hominem/omiro",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build:dev": "pnpm dlx eas-cli@21.2.0 build --platform ios --profile development",
    "build:e2e": "pnpm dlx eas-cli@21.2.0 build --platform ios --profile e2e",
    "build:screenshots": "pnpm dlx eas-cli@21.2.0 build --platform ios --profile screenshots",
    "build:prod": "pnpm dlx eas-cli@21.2.0 build --platform ios --profile production",
    "release": "APP_ENV=production pnpm dlx eas-cli@21.2.0 build --platform ios --profile production --auto-submit --non-interactive",
    "check:cng": "bash scripts/check-cng.sh",
    "check:build-config": "bash scripts/check-eas-build-config.sh",
    "check:ota-safe": "bash scripts/check-ota-safe.sh",
    "dev": "APP_ENV=development expo start --clear",
    "eas-build-post-install": "pnpm --filter @ponti-studios/auth build",
    "export:embed:ios": "pnpm --filter @ponti-studios/auth build && APP_ENV=production expo export:embed --eager --platform ios --dev false",
    "format": "oxfmt env.ts components app config constants hooks services tests types --write",
    "format:check": "oxfmt env.ts components app config constants hooks services tests types --check",
    "lint": "oxlint env.ts app components config constants hooks services tests types",
    "lint:expo": "expo lint",
    "lint:fix": "oxlint env.ts app components config constants hooks services tests types --fix",
    "prebuild:dev": "APP_ENV=development SENTRY_USE_XCFRAMEWORK=0 pnpm exec expo prebuild --platform ios --clean",
    "prebuild:prod": "APP_ENV=production SENTRY_USE_XCFRAMEWORK=0 pnpm exec expo prebuild --platform ios --clean",
    "prebuild:screenshots": "APP_ENV=screenshots SENTRY_USE_XCFRAMEWORK=0 pnpm exec expo prebuild --platform ios --clean",
    "run:ios": "APP_ENV=development SENTRY_USE_XCFRAMEWORK=0 expo run:ios",
    "run:ios:e2e": "APP_ENV=e2e SENTRY_USE_XCFRAMEWORK=0 expo run:ios",
    "start:ios": "APP_ENV=development expo start --dev-client --ios",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "update": "APP_ENV=production pnpm dlx eas-cli@21.2.0 update --channel production"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.23",
    "@expo/metro-runtime": "~57.0.8",
    "@expo/ui": "~57.0.8",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hominem/chat": "workspace:*",
    "@hominem/env": "workspace:*",
    "@hominem/rpc": "workspace:*",
    "@hominem/storage": "workspace:*",
    "@hominem/telemetry": "workspace:*",
    "@hominem/utils": "workspace:*",
    "@ponti-studios/auth": "workspace:*",
    "@ponti-studios/ui": "catalog:",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "^8.20.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-sync-storage-persister": "5.101.4",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "better-auth": "1.6.23",
    "expo": "^57.0.8",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.7",
    "expo-camera": "^57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "^57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-local-authentication": "^57.0.2",
    "expo-localization": "~57.0.1",
    "expo-media-library": "~57.0.3",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-screen-capture": "^57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "^57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-store-review": "^57.0.1",
    "expo-symbols": "^57.0.1",
    "expo-updates": "~57.0.10",
    "posthog-react-native": "^4.45.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.1",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^4.2.0",
    "react-native-nitro-image": "^0.14.0",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-vision-camera": "^5.2.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@expo/plist": "^0.8.1",
    "@sentry/cli": "3.6.1",
    "oxlint-config-universe": "^0.0.3",
    "typescript": "6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-image",
          "omiro-intents",
          "voice-transcriber",
          "on-device-ai"
        ]
      }
    }
  }
}
