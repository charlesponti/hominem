# Served by portless (see /portless.json) at a stable name, independent of
# whatever port the api/career dev servers actually land on. Port 4200 is
# the portless proxy itself (`pnpm exec portless proxy start --port 4200`).
VITE_PUBLIC_API_URL=https://api.localhost:4200
PUBLIC_APP_URL=https://career.localhost:4200
# Required server-only base URL for session checks. Use the API's Railway-private URL in production.
HOMINEM_INTERNAL_API_URL=https://api.localhost:4200

# AI
OPENROUTER_API_KEY=

# Data
DATABASE_URL=

# Storage
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_URL=http://localhost:9000
R2_BUCKET_NAME=storage
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
