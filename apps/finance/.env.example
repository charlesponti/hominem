# Public API for the finance app. Served by portless (each app declares
# its own name/port via the "portless" key in its package.json) at a
# stable name, independent of whatever port the dev servers land on.
# Port 4200 is the portless proxy itself
# (`pnpm exec portless proxy start --port 4200 --tld lvh.me`).
# lvh.me (not .localhost) so the cross-subdomain session cookie actually
# works — see AUTH_COOKIE_DOMAIN in services/api/.env.example.
VITE_PUBLIC_API_URL=https://api.lvh.me:4200
PUBLIC_APP_URL=https://finance.lvh.me:4200
# Required server-only base URL for session checks. Use the API's Railway-private URL in production.
HOMINEM_INTERNAL_API_URL=https://api.lvh.me:4200
# Required server-only database URL: route loaders in this app read the
# ledger directly via @hominem/finance-services (no new API routes).
# Point at the shared local Postgres in development.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/hominem

# Optional Plaid sandbox settings used by finance connections
VITE_R2_DOMAIN=
PLAID_CLIENT_ID=
PLAID_API_KEY=
PLAID_ENV="sandbox"
