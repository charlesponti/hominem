# Public API for the finance app. Served by portless (see /portless.json)
# at a stable name, independent of whatever port the dev servers land on.
VITE_PUBLIC_API_URL=https://api.localhost
PUBLIC_APP_URL=https://finance.localhost
# Required server-only base URL for session checks. Use the API's Railway-private URL in production.
HOMINEM_INTERNAL_API_URL=https://api.localhost

# Optional Plaid sandbox settings used by finance connections
VITE_R2_DOMAIN=
PLAID_CLIENT_ID=
PLAID_API_KEY=
PLAID_ENV="sandbox"
