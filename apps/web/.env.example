# Browser-facing public API origin (hosted login, Better Auth browser
# client, browser RPC/file calls). Local dev: https://api.lvh.me:4200,
# served by portless (each app declares its own name/port via the
# "portless" key in its package.json; 4200 is the proxy port from
# `pnpm exec portless proxy start --port 4200 --tld lvh.me`, independent
# of app port). lvh.me (not .localhost) so the cross-subdomain session
# cookie actually works — see AUTH_COOKIE_DOMAIN in
# services/api/.env.example.
VITE_PUBLIC_API_URL=""

# Server-only API origin for SSR session resolution and server-side data
# calls. Local dev points it at the local API (https://api.lvh.me:4200);
# production uses the Railway-private API URL. Never fall back to
# VITE_PUBLIC_API_URL.
HOMINEM_INTERNAL_API_URL=""

# Public origin of this web app, used for hosted-login return URLs.
# Local dev: https://web.lvh.me:4200.
PUBLIC_APP_URL=""

# PostHog (feature flags + analytics)
# Get your key at https://us.posthog.com/project/settings
VITE_POSTHOG_PUBLIC_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# Browser telemetry
# Set VITE_OTEL_DISABLED=true to force telemetry off.
VITE_OTEL_DISABLED="false"
VITE_OTEL_SERVICE_NAME="web"
VITE_OTEL_SERVICE_VERSION="0.0.0"
VITE_OTEL_DEPLOYMENT_ENVIRONMENT="development"
VITE_OTEL_EXPORTER_OTLP_ENDPOINT="none"
VITE_OTEL_TRACES_SAMPLER_ARG="1.0"
