{
  "name": "@hominem/services",
  "version": "0.0.0",
  "description": "Business logic and services",
  "type": "module",
  "sideEffects": false,
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./src/index.ts"
    },
    "./emails": {
      "types": "./build/resend.d.ts",
      "default": "./src/resend.ts"
    },
    "./resend": {
      "types": "./build/resend.d.ts",
      "default": "./src/resend.ts"
    },
    "./files": {
      "types": "./build/files.d.ts",
      "default": "./src/files.ts"
    },
    "./types": {
      "types": "./build/types.d.ts",
      "default": "./src/types.ts"
    },
    "./env": {
      "types": "./build/env.d.ts",
      "default": "./src/env.ts"
    },
    "./redis": {
      "types": "./build/redis.d.ts",
      "default": "./src/redis.ts"
    },
    "./test-utils/google-api-mocks": {
      "types": "./build/test-utils/google-api-mocks.d.ts",
      "default": "./src/test-utils/google-api-mocks.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "@hominem/env": "workspace:*",
    "@hominem/telemetry": "workspace:*",
    "@hominem/utils": "workspace:*",
    "bullmq": "catalog:",
    "dotenv": "catalog:",
    "ioredis": "catalog:",
    "mammoth": "^1.9.1",
    "pdf2json": "catalog:",
    "resend": "catalog:",
    "zod": "catalog:"
  }
}
