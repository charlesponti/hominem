{
  "name": "@hominem/services",
  "version": "0.0.0",
  "description": "Business logic and services",
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./emails": {
      "types": "./src/resend.ts",
      "default": "./src/resend.ts"
    },
    "./resend": {
      "types": "./src/resend.ts",
      "default": "./src/resend.ts"
    },
    "./files": {
      "types": "./src/files.ts",
      "default": "./src/files.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./src/env.ts"
    },
    "./redis": {
      "types": "./src/redis.ts",
      "default": "./src/redis.ts"
    },
    "./resume": {
      "types": "./src/resume.ts",
      "default": "./src/resume.ts"
    },
    "./test-utils/google-api-mocks": {
      "types": "./src/test-utils/google-api-mocks.ts",
      "default": "./src/test-utils/google-api-mocks.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "@hominem/ai": "workspace:*",
    "@hominem/db": "workspace:*",
    "@hominem/env": "workspace:*",
    "@hominem/telemetry": "workspace:*",
    "@hominem/utils": "workspace:*",
    "bullmq": "catalog:",
    "dotenv": "catalog:",
    "ioredis": "catalog:",
    "mammoth": "^1.9.1",
    "pdf2json": "catalog:",
    "resend": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hominem/queues": "workspace:*"
  }
}
