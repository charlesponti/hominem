{
  "name": "@hominem/chat",
  "version": "0.0.0",
  "description": "Chat and messaging services",
  "type": "module",
  "sideEffects": false,
  "types": "./build/public.d.ts",
  "exports": {
    ".": {
      "types": "./build/public.d.ts",
      "default": "./src/public.ts"
    },
    "./types": {
      "types": "./build/types-only.d.ts",
      "default": "./src/types-only.ts"
    },
    "./ui": {
      "types": "./build/session-artifacts.d.ts",
      "default": "./src/session-artifacts.ts"
    },
    "./react": {
      "types": "./build/use-chat-lifecycle.d.ts",
      "default": "./src/use-chat-lifecycle.ts"
    },
    "./constants": {
      "types": "./build/constants.d.ts",
      "default": "./src/constants.ts"
    },
    "./sse": {
      "types": "./build/sse.d.ts",
      "default": "./src/sse.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.0",
    "react": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
