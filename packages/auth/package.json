{
  "name": "@ponti-studios/auth",
  "version": "0.1.0",
  "description": "Unified authentication package for Hominem apps (web, mobile, CLI)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./shared/mask-email": {
      "types": "./src/shared/mask-email.ts",
      "default": "./src/shared/mask-email.ts"
    },
    "./shared/validation": {
      "types": "./src/shared/validation.ts",
      "default": "./src/shared/validation.ts"
    },
    "./shared/redirect-policy": {
      "types": "./src/shared/redirect-policy.ts",
      "default": "./src/shared/redirect-policy.ts"
    },
    "./shared/protocol": {
      "types": "./src/shared/protocol.ts",
      "default": "./src/shared/protocol.ts"
    },
    "./client/provider": {
      "types": "./src/client/provider.tsx",
      "default": "./src/client/provider.tsx"
    },
    "./client/email-auth": {
      "types": "./src/client/email-auth.ts",
      "default": "./src/client/email-auth.ts"
    },
    "./client/email-otp-route": {
      "types": "./src/client/email-otp-route.ts",
      "default": "./src/client/email-otp-route.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "better-auth": "1.6.23"
  },
  "devDependencies": {
    "@hominem/utils": "workspace:*",
    "react": "catalog:",
    "vitest": "4.1.0"
  },
  "peerDependencies": {
    "@hominem/utils": "workspace:*",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "@hominem/utils": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponti-studios/hominem.git",
    "directory": "packages/auth"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./types": {
        "types": "./build/types.d.ts",
        "default": "./build/types.js"
      },
      "./shared/mask-email": {
        "types": "./build/shared/mask-email.d.ts",
        "default": "./build/shared/mask-email.js"
      },
      "./shared/validation": {
        "types": "./build/shared/validation.d.ts",
        "default": "./build/shared/validation.js"
      },
      "./shared/redirect-policy": {
        "types": "./build/shared/redirect-policy.d.ts",
        "default": "./build/shared/redirect-policy.js"
      },
      "./shared/protocol": {
        "types": "./build/shared/protocol.d.ts",
        "default": "./build/shared/protocol.js"
      },
      "./client/provider": {
        "types": "./build/client/provider.d.ts",
        "default": "./build/client/provider.js"
      },
      "./client/email-auth": {
        "types": "./build/client/email-auth.d.ts",
        "default": "./build/client/email-auth.js"
      },
      "./client/email-otp-route": {
        "types": "./build/client/email-otp-route.d.ts",
        "default": "./build/client/email-otp-route.js"
      },
      "./server": {
        "types": "./build/server.d.ts",
        "default": "./build/server.js"
      }
    }
  }
}
