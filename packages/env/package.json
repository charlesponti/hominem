{
  "name": "@hominem/env",
  "version": "0.0.0",
  "description": "Unified environment handling, schemas, and brand identity",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./build/runtime.d.ts",
      "default": "./src/runtime.ts"
    },
    "./database": {
      "types": "./build/database.d.ts",
      "default": "./src/database.ts"
    },
    "./ai": {
      "types": "./build/ai.d.ts",
      "default": "./src/ai.ts"
    },
    "./email": {
      "types": "./build/email.d.ts",
      "default": "./src/email.ts"
    },
    "./storage": {
      "types": "./build/storage.d.ts",
      "default": "./src/storage.ts"
    },
    "./redis": {
      "types": "./build/redis.d.ts",
      "default": "./src/redis.ts"
    },
    "./brand": {
      "types": "./build/brand.d.ts",
      "default": "./src/brand.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "vitest run src",
    "typecheck": "rm -rf .cache && tsc --noEmit",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
