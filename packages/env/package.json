{
  "name": "@hominem/env",
  "version": "0.0.0",
  "description": "Unified environment handling, schemas, and brand identity",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./src/index.ts"
    },
    "./base": {
      "types": "./build/base.d.ts",
      "default": "./src/base.ts"
    },
    "./api": {
      "types": "./build/api.d.ts",
      "default": "./src/api.ts"
    },
    "./web": {
      "types": "./build/web.d.ts",
      "default": "./src/web.ts"
    },
    "./career": {
      "types": "./build/career.d.ts",
      "default": "./src/career.ts"
    },
    "./finance": {
      "types": "./build/finance.d.ts",
      "default": "./src/finance.ts"
    },
    "./brand": {
      "types": "./build/brand.d.ts",
      "default": "./src/brand.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "rm -rf .cache && tsc --noEmit",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {}
}
