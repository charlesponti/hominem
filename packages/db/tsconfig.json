{
  "extends": "../../tsconfig.profiles/package.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "./build",
    "tsBuildInfoFile": "./.cache/tsconfig.tsbuildinfo",
    "paths": {
      "@hominem/chat": ["../chat/build/public.d.ts"],
      "@hominem/chat/projection": ["../chat/build/projection.d.ts"],
      "@hominem/db/schema/*": ["./src/migrations/schema.ts"],
      "@hominem/db/services/*": ["./src/services/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "build", "dist", ".turbo", ".cache", "coverage", "*.tsbuildinfo"],
  "references": [{ "path": "../chat" }, { "path": "../env" }, { "path": "../utils" }]
}
