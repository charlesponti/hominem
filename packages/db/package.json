{
  "name": "@hominem/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./src/index.ts"
    },
    "./types/*": {
      "types": "./build/types/*.d.ts",
      "default": "./src/types/*.ts"
    },
    "./services/*": {
      "types": "./build/services/*.d.ts",
      "default": "./src/services/*.ts"
    },
    "./test/*": {
      "types": "./build/test/*.d.ts",
      "default": "./src/test/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "@hominem/chat": "workspace:*",
    "@hominem/env": "workspace:*",
    "@hominem/utils": "workspace:*",
    "kysely": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "catalog:",
    "kysely-codegen": "^0.20.0",
    "vitest": "catalog:"
  }
}
