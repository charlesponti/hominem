{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "career",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@hominem/career", "dev"],
      "port": 4451,
      "autoPort": true
    },
    {
      "name": "finance",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@hominem/finance", "dev"],
      "port": 4444
    },
    {
      "name": "ui-storybook",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd $HOME/Developer/ui && pnpm exec storybook dev -p 6006 --ci"
      ],
      "port": 6006
    }
  ]
}
