{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // tsserver-only (see AGENTS.md "Build / CI" — ignored by plain tsc/CI
    // runs, confirmed this session): trades full transitive re-checking
    // for editor responsiveness in this project-reference graph. Anything
    // outside the tsconfig.profiles/* chain (e.g. apps/omiro) must set this
    // explicitly in its own tsconfig.json.
    "assumeChangesOnlyAffectDirectDependencies": true
  },
  "exclude": ["node_modules", "tmp"]
}
